Extension: SearchParameterValueSetLatest
Id: VSLatest
Title: "Search Parameter - Latest for ValueSets"
Description: "Limit response of ValueSets to match given Latest."

* ^status = #active
* ^publisher = "Trifork Digital Health A/S"
